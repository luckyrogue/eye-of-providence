# Dev image — hot-reload через air. НЕ для production.
FROM golang:1.25-alpine

RUN apk add --no-cache git ca-certificates

# Air для hot-reload
RUN go install github.com/air-verse/air@latest

WORKDIR /app

# go mod cache prefill
COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
