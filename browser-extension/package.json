{
  "name": "@eop/browser-extension",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "package": "pnpm run build && pnpm run zip:dist",
    "zip:dist": "cd dist && zip -r ../eop-browser-extension-$npm_package_version.zip .",
    "install:hint": "echo 'Build first → load `dist/` (НЕ корневую папку) в chrome://extensions Developer mode → Load unpacked.'"
  },
  "dependencies": {
    "@eop/i18n": "workspace:*",
    "@eop/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
