# Eye of Providence — пример переменных окружения для self-hosted deploy.
# Скопируй в .env и заполни — никогда не коммить .env с реальными значениями.

# --- Среда ---
EOP_ENV=production                       # development|production — production включает строгие проверки конфигурации
EOP_HTTP_ADDR=:8080                      # listen address API

# --- БД ---
EOP_POSTGRES_DSN=postgres://eop:CHANGE_ME@postgres:5432/eop?sslmode=disable
EOP_CLICKHOUSE_DSN=clickhouse://eop:CHANGE_ME@clickhouse:9000/eop
EOP_REDIS_ADDR=redis:6379
POSTGRES_PASSWORD=CHANGE_ME              # для docker-compose
CLICKHOUSE_PASSWORD=CHANGE_ME

# --- Connection pool tuning (опц.) ---
# EOP_PG_MAX_CONNS=20
# EOP_PG_MIN_CONNS=2

# --- Auth ---
EOP_JWT_SECRET=CHANGE_ME_TO_RANDOM_32_PLUS_CHARS  # `openssl rand -hex 32`
EOP_INVITE_ONLY=true                     # регистрация только по invite (первый user — bootstrap)
EOP_ENABLE_DEV_TOKEN=false               # /v1/auth/dev-token — НЕ включай в production

# --- CORS ---
EOP_ALLOWED_ORIGINS=https://eop.rysdavletov.org

# --- Body limit ---
# EOP_BODY_LIMIT_BYTES=1048576           # 1 MiB default

# --- Migrations ---
EOP_AUTO_MIGRATE=true                    # API сам прогонит SQL-миграции на старте

# --- AI / OAuth (опционально) ---
EOP_GEMINI_API_KEY=                      # https://aistudio.google.com/apikey — пусто = mock-режим
EOP_GITHUB_CLIENT_ID=
EOP_GITHUB_CLIENT_SECRET=
EOP_GITHUB_CALLBACK_URL=https://eop.rysdavletov.org/api/v1/auth/github/callback

# --- Transactional emails (Resend) ---
# Пусто = Mailer работает в Noop-режиме (письма только пишутся в логи, без HTTP).
# Получить key: https://resend.com/api-keys (нужен верифицированный домен).
EOP_RESEND_API_KEY=
EOP_MAIL_FROM=Eye of Providence <noreply@eop.rysdavletov.org>
EOP_PUBLIC_URL=https://eop.rysdavletov.org

# --- Reports cron ---
EOP_REPORTS_CRON_SEC=21600               # 6h; 0 = выключено

# --- Frontend build ---
VITE_BACKEND_URL=https://eop.rysdavletov.org/api

# --- Compose-only ---
API_PORT=8080
DASHBOARD_PORT=8081
